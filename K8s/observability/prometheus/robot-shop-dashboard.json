{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Robot Shop synthetic availability, application business metrics, and Kubernetes workload health. HTTP request/error panels describe synthetic probes; existing services do not expose general HTTP server counters.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Successful synthetic GET / probes over the rolling 30-day SLO window. No data means the probe is not configured or has not scraped yet.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "avg_over_time(probe_success{job=\"robot-shop-web-probe\"}[30d])",
          "legendFormat": "30-day availability",
          "refId": "A"
        }
      ],
      "title": "Storefront availability (30d)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Approximate synthetic GET checks per second, not total application traffic. The scrape interval determines the observed request frequency.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "count_over_time(probe_success{job=\"robot-shop-web-probe\"}[5m]) / 300",
          "legendFormat": "synthetic checks/sec",
          "refId": "A"
        }
      ],
      "title": "Synthetic request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Fraction of failed synthetic web probes. This is not an application-wide HTTP error rate.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "1 - avg_over_time(probe_success{job=\"robot-shop-web-probe\"}[5m])",
          "legendFormat": "synthetic probe failure ratio",
          "refId": "A"
        }
      ],
      "title": "Synthetic error ratio (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "95th percentile of the blackbox probe duration samples over one hour. This measures storefront probe latency, not per-route server latency.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, probe_duration_seconds{job=\"robot-shop-web-probe\"}[1h])",
          "legendFormat": "web p95 probe duration",
          "refId": "A"
        }
      ],
      "title": "Storefront latency (p95, 1h)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Available replicas by Robot Shop Deployment. Values below desired replicas indicate a workload availability issue.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"default\"}",
          "legendFormat": "{{deployment}} available",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"default\"}",
          "legendFormat": "{{deployment}} desired",
          "refId": "B"
        }
      ],
      "title": "Robot Shop Deployment replicas",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Container restarts in the last hour. A rising count is an investigation signal, not a diagnosis.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"default\"}[1h])",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "title": "Container restarts (1h)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Working set by container. Compare with configured requests/limits; cAdvisor/container metrics must be available.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"default\",container!=\"\",container!=\"POD\"}",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "title": "Container memory working set",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU usage rate by container. Container metric availability depends on kubelet scraping and cluster policy.",
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"default\",container!=\"\",container!=\"POD\"}[5m])",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cart and payment emit HTTP request counters and duration histograms. Other Robot Shop services are not instrumented by this change.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{namespace=\"default\"}[5m]))",
          "legendFormat": "{{service}} requests/sec",
          "refId": "A"
        },
        {
          "expr": "sum by (service) (rate(http_requests_total{namespace=\"default\",status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}} 5xx/sec",
          "refId": "B"
        }
      ],
      "title": "Application HTTP request and 5xx rate (cart/payment)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cart and payment emit route-labelled request duration histograms. Other Robot Shop services require separate instrumentation.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{namespace=\"default\"}[5m])))",
          "legendFormat": "{{service}} p95 route latency",
          "refId": "B"
        }
      ],
      "title": "Application HTTP route latency (p95, cart/payment)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["robot-shop", "capstone-2", "observability"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Robot Shop - Capstone 2",
  "uid": "robot-shop-capstone-2",
  "version": 1,
  "weekStart": ""
}
